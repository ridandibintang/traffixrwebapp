# Copy to .env.local and fill in from Supabase Dashboard > Project Settings > API Keys.

# Public (safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Older projects expose an anon key instead; either variable works.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Server-only. Used by scripts/seed.ts to create Auth users. Never ship to the browser.
SUPABASE_SECRET_KEY=sb_secret_...
# Older projects: SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Seed accounts for `npm run db:seed`. Change the password before running.
SEED_PASSWORD=change-me-before-seeding
SEED_ADMIN_EMAIL=admin@traffixr.test
SEED_WRITER_AURA_EMAIL=aura@traffixr.test
SEED_WRITER_HAMZAH_EMAIL=hamzah@traffixr.test
